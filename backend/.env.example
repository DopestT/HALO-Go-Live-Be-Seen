# Environment
# development | test | staging | production
APP_ENV=development

# Server Configuration
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10
SERVER_IDLE_TIMEOUT=120
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=halo
# Development may use disable locally. Production requires verify-full.
DB_SSL_MODE=disable
# Optional in development. In production set this when your provider requires a custom CA bundle.
DB_SSL_ROOT_CERT=
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=3600

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=100
REDIS_MIN_IDLE_CONNS=10

# JWT Configuration
# Production requires at least 32 bytes of secret material. Inject through the deployment secret store.
JWT_SECRET_KEY=development-only-secret-change-before-production
JWT_EXPIRATION_HOURS=24

# CORS Configuration
# Wildcard is development-only. Production accepts explicit HTTPS origins only.
# Example: CORS_ALLOWED_ORIGINS=https://halo.example.com,https://www.halo.example.com
CORS_ALLOWED_ORIGINS=*
